{
  "name": "agent-manager",
  "version": "0.1.0",
  "description": "Manage Claude Code CLI terminals across projects",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/copy-hook.cjs",
    "dist": "npm run build && electron-builder --win",
    "start": "electron-vite preview",
    "test": "vitest run",
    "postinstall": "node scripts/rebuild-native.cjs"
  },
  "build": {
    "appId": "com.arw.agentmanager",
    "productName": "ARWCode",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "out/main/hook-script",
        "to": "hook-script"
      }
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.1.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  }
}
